{
  "include": [
    "~/.config/waybar/common.jsonc"
  ],
  // Choose the order of the modules
  "modules-left": [
    "custom/spacer",
    "custom/applications",
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "tray",
    "custom/spacer"
  ],
  "niri/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{index}"
  },
  "niri/window": {
    "max-length": 60,
    "format": "<span color='#c0c0c0' style=\"italic\">{}</span>"
  }
}
